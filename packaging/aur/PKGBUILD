# Maintainer: harukizmoe <harukizmoe@gmail.com>
pkgname=niripaper
pkgver=0.2.0
pkgrel=1
pkgdesc="A parallax wallpaper daemon for the niri compositor"
arch=('x86_64')
url="https://github.com/harukizmoe/niripaper"
license=('GPL-3.0-or-later')
# What the binary links by hand: libmpv.so.2 (video), libEGL/libGL (libglvnd),
# libgbm.so.1 (mesa), libwayland-client.so.0 (wayland).
depends=('mpv' 'libglvnd' 'mesa' 'wayland')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# GitHub's tag archives are not guaranteed to stay byte-identical, so this is
# left as SKIP; put the real sum in when pushing to the AUR.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/niripaper "$pkgdir/usr/bin/niripaper"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
